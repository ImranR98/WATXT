{
  "name": "watxt",
  "version": "1.0.0",
  "private": true,
  "description": "W@TXT - browse, search, import and merge WhatsApp chat exports",
  "type": "module",
  "author": "Imran Remtulla",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server.mjs",
    "build:ui": "vite build",
    "watch:ui": "vite build --watch",
    "check": "node checkFormat.mjs",
    "check-examples": "node checkFormat.mjs --check-examples",
    "lint": "eslint .",
    "test": "npm run build:ui && node checkFormat.mjs --check-examples && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@dscpln/server-kit": "file:./kit/packages/server-kit",
    "express": "^5.0.0"
  },
  "devDependencies": {
    "@dscpln/test-kit": "file:./kit/packages/test-kit",
    "@dscpln/ui-kit": "file:./kit/packages/ui-kit",
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "playwright-core": "1.64.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.4"
  }
}
